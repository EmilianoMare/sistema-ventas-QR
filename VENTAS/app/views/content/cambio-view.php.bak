</div>

<style>
.level {
    margin-bottom: 0 !important;
}
.level-item {
    padding: 20px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function(){
    const btn = document.getElementById('btnActualizarAPI');
    const msgBox = document.createElement('div');
    msgBox.id = 'apiMessage';
    msgBox.style.marginTop = '10px';
    const parentBox = document.querySelector('.box.has-background-warning-light');
    if(parentBox) parentBox.appendChild(msgBox);

    if(!btn) return;

    btn.addEventListener('click', function(){
        btn.disabled = true;
        const oldText = btn.innerHTML;
        btn.innerHTML = '<span class="icon"><i class="fas fa-spinner fa-pulse"></i></span><span>Actualizando...</span>';
        msgBox.innerHTML = '';

        // Llamar primero al endpoint que fuerza la consulta a la API
        fetch('<?php echo APP_URL; ?>app/ajax/cambioAjax.php?obtener=cambio_api', {cache: 'no-store'})
        .then(r => r.json())
        .then(data => {
            if(data.status === 'success'){
                // Obtener la información actualizada desde el endpoint local y refrescar la UI
                return fetch('<?php echo APP_URL; ?>app/ajax/cambioAjax.php?obtener=cambio', {cache: 'no-store'})
                    .then(r2 => r2.json())
                    .then(info => ({api: data, info: info}));
            } else if(data.status === 'disabled'){
                throw new Error(data.mensaje || 'Actualización automática deshabilitada');
            } else {
                throw new Error(data.mensaje || 'Error al consultar API');
            }
        })
        .then(result => {
            const info = result.info;
            // Actualizar precio
            if(info.valor !== undefined){
                const precioEl = document.getElementById('precioCambio');
                precioEl.textContent = parseFloat(info.valor).toFixed(2);
            }
            // Actualizar fecha y fuente
            const fechaHidden = document.getElementById('fechaCambio');
            if(info.fecha){
                fechaHidden.value = info.fecha;
                // actualizar el visible fecha (the element showing date is the second .level-item .title.is-6)
                const fechaEls = document.querySelectorAll('.box.has-background-info-light .level-item .title.is-6');
                if(fechaEls && fechaEls.length>0){
                    fechaEls[0].textContent = new Date(info.fecha).toLocaleString();
                }
            }
            if(info.fuente){
                const fuenteEl = document.getElementById('fuenteCambio');
                if(fuenteEl) fuenteEl.textContent = info.fuente + (info.fuente.toLowerCase().indexOf('banco')!==-1 ? ' (Venta)' : '');
            }

            msgBox.innerHTML = '<div class="notification is-success">Tipo de cambio actualizado: ' + (result.info.valor ? parseFloat(result.info.valor).toFixed(2) : '') + ' ARS</div>';
        })
        .catch(err => {
            msgBox.innerHTML = '<div class="notification is-danger">Error: ' + (err.message || err) + '</div>';
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = oldText;
        });
    });
    // Toggle auto/manual mode
    const btnToggle = document.getElementById('btnToggleModo');
    if(btnToggle){
        btnToggle.addEventListener('click', function(){
            const enable = btnToggle.getAttribute('data-enabled') === '1' ? 0 : 1;
            btnToggle.disabled = true;
            fetch('<?php echo APP_URL; ?>app/ajax/cambioAjax.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'modulo_cambio=toggle_api_mode&habilitar='+encodeURIComponent(enable)
            })
            .then(r=>r.json())
            .then(d=>{
                if(d.status === 'success'){
                    // actualizar etiqueta y estado del botón
                    btnToggle.setAttribute('data-enabled', d.enabled ? '1' : '0');
                    btnToggle.textContent = d.enabled ? 'Deshabilitar auto' : 'Habilitar auto';
                    const upBtn = document.getElementById('btnActualizarAPI');
                    if(upBtn) upBtn.disabled = d.enabled ? false : true;
                    const msg = document.getElementById('apiMessage');
                    if(msg) msg.innerHTML = '<div class="notification is-success">Modo actualizado: ' + (d.enabled ? 'Automático' : 'Manual') + '</div>';
                } else {
                    throw new Error(d.mensaje || 'Error al cambiar modo');
                }
            })
            .catch(err=>{
                const msg = document.getElementById('apiMessage');
                if(msg) msg.innerHTML = '<div class="notification is-danger">'+(err.message||err)+'</div>';
            })
            .finally(()=>{ btnToggle.disabled = false; });
        });
    }
});
</script>
