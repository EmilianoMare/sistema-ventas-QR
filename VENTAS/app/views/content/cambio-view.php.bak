                <?php else: ?>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <button class="button is-warning" id="btnActualizarAPI" disabled>
                            <span class="icon"><i class="fas fa-globe"></i></span>
                            <span>Actualizar desde API (No disponible)</span>
                        </button>
